<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                                http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.edu.eaut</groupId>
    <artifactId>lab01-java-console</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- Plugin đóng gói file JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>

                    <!-- Bài 01 -->
                    <execution>
                        <id>jar-bai01</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>Bai01</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>vn.edu.eaut.lab4.CountdownFrame</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>

                    <!-- Bài 02 -->
                    <execution>
                        <id>jar-bai02</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>Bai02</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>vn.edu.eaut.lab4.FibonacciFrame</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>

                    <!-- Bài 03 -->
                    <execution>
                        <id>jar-bai03</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>Bai03</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>vn.edu.eaut.lab4.FileLineCounterFrame</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>

                    <!-- Bài 04 -->
                    <execution>
                        <id>jar-bai04</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>Bai04</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>vn.edu.eaut.lab4.PrimeSumFrame</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>

                    <!-- Bài 05 -->
                    <execution>
                        <id>jar-bai05</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>Bai05</classifier>
                            <archive>
                                <manifest>
                                    <mainClass>vn.edu.eaut.lab4.ProgressDemoFrame</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>

                </executions>
            </plugin>
        </plugins>
    </build>
</project>