<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,vn.edu.eaut.lab10.model.Student" %>
<%List<Student> items=(List<Student>)request.getAttribute("items");%><!DOCTYPE html><html><head><title>Sinh viên</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><div class="wrap"><a href="../dashboard.jsp">← Dashboard</a><h2>Quản lý sinh viên</h2>
<form method="post"><input type="hidden" name="action" value="create"><input name="code" placeholder="Mã SV" required><input name="fullName" placeholder="Họ tên" required><input type="email" name="email" placeholder="Email" required><input name="major" placeholder="Ngành"><button>Thêm</button></form>
<table><tr><th>Mã</th><th>Họ tên</th><th>Email</th><th>Ngành</th><th>Xóa</th></tr><%for(Student x:items){%><tr><td><%=x.getCode()%></td><td><%=x.getFullName()%></td><td><%=x.getEmail()%></td><td><%=x.getMajor()%></td><td><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=x.getId()%>"><button>Xóa</button></form></td></tr><%}%></table></div></body></html>