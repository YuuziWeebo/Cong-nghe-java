<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,vn.edu.eaut.lab10.model.Book" %><%List<Book> items=(List<Book>)request.getAttribute("items");%>
<!DOCTYPE html><html><head><title>Sách</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><div class="wrap"><a href="../dashboard.jsp">← Dashboard</a><h2>Quản lý sách</h2>
<form method="post"><input type="hidden" name="action" value="create"><input name="isbn" placeholder="ISBN" required><input name="title" placeholder="Tên sách" required><input name="author" placeholder="Tác giả" required><input type="number" name="quantity" min="0" placeholder="Số lượng" required><button>Thêm</button></form>
<table><tr><th>ISBN</th><th>Tên sách</th><th>Tác giả</th><th>Số lượng</th><th>Xóa</th></tr><%for(Book x:items){%><tr><td><%=x.getIsbn()%></td><td><%=x.getTitle()%></td><td><%=x.getAuthor()%></td><td><%=x.getQuantity()%></td><td><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=x.getId()%>"><button>Xóa</button></form></td></tr><%}%></table></div></body></html>