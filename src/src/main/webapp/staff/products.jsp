<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List,vn.edu.eaut.lab10.model.Product" %><%List<Product> items=(List<Product>)request.getAttribute("items");%>
<!DOCTYPE html><html><head><title>Sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body><div class="wrap"><a href="../dashboard.jsp">← Dashboard</a><h2>Quản lý sản phẩm</h2>
<form method="post"><input type="hidden" name="action" value="create"><input name="code" placeholder="Mã SP" required><input name="name" placeholder="Tên sản phẩm" required><input type="number" name="price" min="0" step="0.01" placeholder="Giá" required><input type="number" name="quantity" min="0" placeholder="Số lượng" required><button>Thêm</button></form>
<table><tr><th>Mã</th><th>Tên</th><th>Giá</th><th>Số lượng</th><th>Xóa</th></tr><%for(Product x:items){%><tr><td><%=x.getCode()%></td><td><%=x.getName()%></td><td><%=String.format("%,.0f",x.getPrice())%></td><td><%=x.getQuantity()%></td><td><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=x.getId()%>"><button>Xóa</button></form></td></tr><%}%></table></div></body></html>