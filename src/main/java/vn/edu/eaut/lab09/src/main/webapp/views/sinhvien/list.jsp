<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Sinh viên</title><style>body{font-family:Arial;max-width:1100px;margin:30px auto}table{width:100%;border-collapse:collapse}th,td{padding:9px;border:1px solid #ddd}a,button{padding:7px 10px;background:#2563eb;color:white;text-decoration:none;border-radius:5px;border:0}input{padding:8px}</style></head><body><a href="index.jsp">← Home</a><h1>Danh sách sinh viên</h1><form><input name="keyword" value="${keyword}" placeholder="Tên / mã / lớp"><button>Tìm kiếm</button><a href="sinh-vien?action=add">+ Thêm</a></form><c:if test="${not empty param.error}"><p style="color:red">${param.error}</p></c:if><c:if test="${not empty sessionScope.msg}"><p style="color:green">${sessionScope.msg}</p><c:remove var="msg" scope="session"/></c:if><table><tr><th>ID</th><th>Mã</th><th>Họ tên</th><th>Email</th><th>Lớp</th><th>Ngày sinh</th><th>Thao tác</th></tr><c:forEach var="s" items="${dsSinhVien}"><tr><td>${s.id}</td><td>${s.maSinhVien}</td><td>${s.hoTen}</td><td>${s.email}</td><td>${s.lopHoc.tenLop}</td><td>${s.ngaySinh}</td><td><a href="sinh-vien?action=edit&id=${s.id}">Sửa</a><a href="sinh-vien?action=delete&id=${s.id}" onclick="return confirm('Xóa?')">Xóa</a></td></tr></c:forEach></table><p>Trang ${page+1} / ${pages}</p><c:if test="${page>0}"><a href="?keyword=${keyword}&page=${page-1}">← Trước</a></c:if><c:if test="${page+1<pages}"><a href="?keyword=${keyword}&page=${page+1}">Sau →</a></c:if></body></html>
