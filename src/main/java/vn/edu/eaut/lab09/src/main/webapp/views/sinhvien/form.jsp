<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><head><title>Form sinh viên</title></head><body style="font-family:Arial;max-width:600px;margin:40px auto"><h1>${empty sv?'Thêm':'Sửa'} sinh viên</h1><form method="post" action="${pageContext.request.contextPath}/sinh-vien"><input type="hidden" name="id" value="${sv.id}"><p>Mã <input required name="maSinhVien" value="${sv.maSinhVien}"></p><p>Họ tên <input required name="hoTen" value="${sv.hoTen}"></p><p>Email <input type="email" name="email" value="${sv.email}"></p><p>Lớp <select required name="lopHocId"><c:forEach var="l" items="${classes}"><option value="${l.id}" ${sv.lopHoc.id==l.id?'selected':''}>${l.tenLop}</option></c:forEach></select></p><p>Ngày sinh <input type="date" name="ngaySinh" value="${sv.ngaySinh}"></p><button>Lưu</button> <a href="${pageContext.request.contextPath}/sinh-vien">Hủy</a></form></body></html>
