<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><body style="font-family:Arial;max-width:800px;margin:40px auto"><a href="index.jsp">Home</a><h1>Môn học</h1><form method="post" action="module"><input type="hidden" name="m" value="mon"><input required name="maMon" placeholder="Mã môn"><input required name="tenMon" placeholder="Tên môn"><input required type="number" name="soTinChi" min="1" max="10" placeholder="TC"><button>Thêm</button></form><table border="1" cellpadding="8" width="100%"><tr><th>Mã</th><th>Tên môn</th><th>Tín chỉ</th></tr><c:forEach var="x" items="${data}"><tr><td>${x.maMon}</td><td>${x.tenMon}</td><td>${x.soTinChi}</td></tr></c:forEach></table></body></html>
