<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><html><body style="font-family:Arial;max-width:800px;margin:40px auto"><a href="index.jsp">Home</a><h1>Lớp học</h1><form method="post" action="module"><input type="hidden" name="m" value="lop"><input required name="tenLop" placeholder="Tên lớp"><button>Thêm</button></form><table border="1" cellpadding="8" width="100%"><tr><th>ID</th><th>Tên lớp</th><th>Số sinh viên</th></tr><c:forEach var="x" items="${data}"><tr><td>${x.id}</td><td>${x.tenLop}</td><td>${x.sinhViens.size()}</td></tr></c:forEach></table></body></html>
